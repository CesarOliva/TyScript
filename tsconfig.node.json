{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/compiler/**/*.ts", "src/Analyzer/ast.ts", "src/Analyzer/lexer.ts", "src/Analyzer/parser.ts", "src/Analyzer/semanticAnalyzer.ts", "src/Analyzer/symbolTable.ts"]
}
